            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "02 · Qué mide y qué no",
                    "textStyle": {
                      "fontSize": "13pt",
                      "color": "#8B58C9",
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Sí: horas, daño y barreras de las personas cuidadoras. ENASIC 2022 (INEGI), nacional.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#2B3045"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "No: cifras por alcaldía ni para la CDMX con la ENASIC; tampoco tendencias, porque es su primera edición.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#2B3045"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "El territorio sale de otras fuentes: Censo 2020, DENUE y CONEVAL.",
                    "textStyle": {
                      "fontSize": "10.5pt",
                      "color": "#2B3045"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Cada fuente declara qué permite y qué prohíbe afirmar",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#5E6274"
                    }
                  }
                ]
              }
            ]
          }
        }
