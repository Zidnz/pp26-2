	column pct_solicitud
		dataType: double
		formatString: 0.00
		lineageTag: dcb4d8a1-6446-52a2-a9db-1b2f610dab90
		summarizeBy: none
		sourceColumn: pct_solicitud

		annotation SummarizationSetBy = User

	partition escala_subsidio = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "escala_subsidio.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"escenario", type text}, {"escenario_orden", Int64.Type}, {"aceptacion", type number}, {"hogares", Int64.Type}, {"costo_mdp", type number}, {"sub_mdp", type number}, {"pct_solicitud", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

