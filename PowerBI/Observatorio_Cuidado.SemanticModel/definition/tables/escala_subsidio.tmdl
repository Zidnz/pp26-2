table escala_subsidio
	lineageTag: a338f81c-e3a5-54ec-bbda-4be18bdaa4b3

	measure 'Hogares atendidos' = SUM(escala_subsidio[hogares])
		formatString: #,0
		lineageTag: 292af5cf-e9f6-5567-9b22-a204abe86c9a

	column escenario
		dataType: string
		lineageTag: 4909e0b0-0bab-5df5-9ba0-0d95bbbe1d4a
		summarizeBy: none
		sourceColumn: escenario

		annotation SummarizationSetBy = User

	column escenario_orden
		dataType: int64
		formatString: 0
		lineageTag: b14101dc-4197-559c-8806-f13c0ed7bd51
		summarizeBy: none
		sourceColumn: escenario_orden

		annotation SummarizationSetBy = User

	column aceptacion
		dataType: double
		formatString: 0.00
		lineageTag: cbc1c44f-cd96-537d-bbaf-55b2e4c99d81
		summarizeBy: none
		sourceColumn: aceptacion

		annotation SummarizationSetBy = User

	column hogares
