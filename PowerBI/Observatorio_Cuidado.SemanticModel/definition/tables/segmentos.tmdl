	partition segmentos = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "segmentos.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"seg_id", type text}, {"dimension", type text}, {"segmento", type text}, {"segmento_etiqueta", type text}, {"orden", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

