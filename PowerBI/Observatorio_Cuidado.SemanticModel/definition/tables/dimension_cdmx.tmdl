table dimension_cdmx
	lineageTag: 340b0484-10ec-5073-97d4-8c5a6a77e120

	measure 'Hogares CDMX con necesidad (cota inferior)' = CALCULATE(SUM(dimension_cdmx[valor]), dimension_cdmx[orden] = 1)
		formatString: #,0
		lineageTag: b2fc401e-6e04-55ee-aa04-13ea07d92095

	measure 'Hogares CDMX que contratan cuidadora' = CALCULATE(SUM(dimension_cdmx[valor]), dimension_cdmx[orden] = 2)
