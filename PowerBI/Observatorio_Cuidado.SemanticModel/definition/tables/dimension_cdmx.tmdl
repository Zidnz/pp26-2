	partition dimension_cdmx = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "dimension_cdmx.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"orden", Int64.Type}, {"nivel", type text}, {"valor", Int64.Type}, {"metodo", type text}, {"evidencia", type text}, {"sesgo", type text}, {"fuente", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

