table estados
	lineageTag: f0f9ac11-aba6-5afa-9aa9-2489db2b95b5

	measure 'Valor entidad' = AVERAGE(estados[valor])
		formatString: 0.0\%
		lineageTag: 354f5b0a-83a2-5983-9203-4142e222fa9e

	measure 'Valor nacional' = AVERAGE(estados[nacional])
		formatString: 0.0\%
		lineageTag: d3939de3-5877-56c9-8b7f-101b7820df6d

	measure 'IC90 inf ent' = AVERAGE(estados[li90])
		formatString: 0.0
		lineageTag: 54eff9da-574c-5f3d-812e-ddb2e189309e

	measure 'IC90 sup ent' = AVERAGE(estados[ls90])
		formatString: 0.0
		lineageTag: 7e11e764-4e38-5796-b718-116e3925057c

	measure 'Color entidad' = IF(MAX(estados[es_cdmx]) = "Sí", "#C0435A", "#B09FD3")
		lineageTag: f507717e-5825-5738-99ee-9e37cc376b5b

