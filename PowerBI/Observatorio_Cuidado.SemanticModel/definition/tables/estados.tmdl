	partition estados = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "estados.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"cve_ent", Int64.Type}, {"entidad", type text}, {"indicador_clave", type text}, {"indicador", type text}, {"indicador_orden", Int64.Type}, {"valor", type number}, {"li90", type number}, {"ls90", type number}, {"cv", type number}, {"n", Int64.Type}, {"precision", type text}, {"nacional", type number}, {"es_cdmx", type text}, {"marginacion_grado", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

