	partition tipologia_tipos = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "tipologia_tipos.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"tipo", Int64.Type}, {"nombre", type text}, {"tipo_txt", type text}, {"n_ageb", Int64.Type}, {"poblacion", Int64.Type}, {"pct_pob_cdmx", type number}, {"n_60", Int64.Type}, {"pct_de_las_60", type number}, {"pct_60", type number}, {"n_disc", Int64.Type}, {"pct_sinder", type number}, {"pct_viv_sin_int", type number}, {"viviendas", Int64.Type}, {"viviendas_sin_internet", Int64.Type}, {"dist_mediana_km", type number}, {"pct_60_a_mas_de_1km", type number}, {"ageb_brecha", Int64.Type}, {"n_60_brecha", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

