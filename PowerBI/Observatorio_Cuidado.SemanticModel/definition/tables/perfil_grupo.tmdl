table perfil_grupo
	lineageTag: b1af4e73-2526-5135-a331-63c450aa2065

	measure 'Porcentaje perfil' = AVERAGE(perfil_grupo[pct])
		formatString: 0.0\%
		lineageTag: cee8b36a-ee2d-504c-842a-d7e2dcd82c1f

	measure 'Dif perfil pp' = AVERAGE(perfil_grupo[dif_pp])
		formatString: +0.0;-0.0;0.0
		lineageTag: 3d67372b-cd82-5706-8513-e57cd20b92f9

	measure 'n perfil' = MAX(perfil_grupo[n])
		formatString: #,0
		lineageTag: 3e086b6d-ebe8-5633-9c89-a71117b34b28

	measure 'Precisión perfil' = MAX(perfil_grupo[precision])
		lineageTag: 8a33e57b-ca87-55dd-abf8-76ce03712e77

	measure '¿Difiere del resto?' = MAX(perfil_grupo[dif_significativa])
		lineageTag: 686f1dac-b4dd-5ee3-a23d-189e8e70afa3

	measure 'Orden perfil' = MIN(perfil_grupo[orden])
		formatString: 0
		lineageTag: 5083fb2c-55d1-5d3f-96e8-e64b72cc6908

