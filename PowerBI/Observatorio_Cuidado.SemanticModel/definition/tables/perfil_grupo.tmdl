	partition perfil_grupo = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "perfil_grupo.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"dimension", type text}, {"segmento", type text}, {"poblacion", type text}, {"orden", Int64.Type}, {"pct", type number}, {"cv", type number}, {"li90", type number}, {"ls90", type number}, {"n", Int64.Type}, {"precision", type text}, {"dif_pp", type number}, {"dif_li90", type number}, {"dif_ls90", type number}, {"dif_significativa", type text}}, "en-US")
