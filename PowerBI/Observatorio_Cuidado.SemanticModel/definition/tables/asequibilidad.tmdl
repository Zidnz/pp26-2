table asequibilidad
	lineageTag: 5a861f6a-3d0d-5b1f-99ec-bc6491412dd6

	measure 'Hogares que podrían pagar' = AVERAGE(asequibilidad[pct_hogares])
		formatString: 0.0\%
		lineageTag: fb8a7ed1-55ca-5b59-8a4d-6b73bb70fc91

	measure 'IC90 inf hogares' = AVERAGE(asequibilidad[li90])
		formatString: 0.0
		lineageTag: 50bd4d14-493e-5db0-bc0b-34c26ea6a619

	measure 'IC90 sup hogares' = AVERAGE(asequibilidad[ls90])
		formatString: 0.0
		lineageTag: a5b698bb-5dff-5d5d-9ab5-ba3feca3c839

	measure 'Parte del ingreso mediano' = AVERAGE(asequibilidad[pct_ingreso_mediano])
		formatString: 0.0\%
		lineageTag: bf31bb09-759b-54a6-9306-c202328751fd

	measure 'Costo mensual' = AVERAGE(asequibilidad[costo_mensual_2026])
		formatString: \$#,0
		lineageTag: dd9a4e92-7158-5e51-a99a-c68eed95a26e

	measure 'Horas paquete' = MIN(asequibilidad[horas])
		formatString: 0
		lineageTag: 96ff1840-face-5381-8e6c-520d6f237d05

	measure 'Precisión hogares' = MAX(asequibilidad[precision])
		lineageTag: 3915273d-b553-590a-9796-d213111d27cc

	measure 'Color tope' = VAR u = MIN(asequibilidad[umbral_orden]) RETURN IF(AVERAGE(asequibilidad[pct_ingreso_mediano]) <= u, "#77689D", "#C0435A")
		lineageTag: ae421bdb-710f-553f-94f8-fd89fc5a196c

	measure 'Costo 6 h piso legal' = CALCULATE(AVERAGE(asequibilidad[costo_mensual_2026]), REMOVEFILTERS(asequibilidad), asequibilidad[fuente_ingreso] = "ENASIC · nacional", asequibilidad[salario_corto] = "Piso legal", asequibilidad[horas] = 6)
		formatString: \$#,0
		lineageTag: 6a9389be-593b-5dbf-9e0a-92690c867027

	measure 'Costo jornada 40 h' = CALCULATE(AVERAGE(asequibilidad[costo_mensual_2026]), REMOVEFILTERS(asequibilidad), asequibilidad[fuente_ingreso] = "ENASIC · nacional", asequibilidad[salario_corto] = "Piso legal", asequibilidad[horas] = 40)
		formatString: \$#,0
		lineageTag: c6220b0e-9f19-544e-922f-2bd78d4d43d8

	measure 'Pagarían 6 h (≤20%)' = CALCULATE(AVERAGE(asequibilidad[pct_hogares]), REMOVEFILTERS(asequibilidad), asequibilidad[fuente_ingreso] = "ENASIC · nacional", asequibilidad[salario_corto] = "Piso legal", asequibilidad[horas] = 6, asequibilidad[umbral_orden] = 20)
		formatString: 0.0\%
		lineageTag: 5bf5b5b7-cfc4-50df-a109-942177deeb96

	measure 'Piso legal por hora' = CALCULATE(AVERAGE(asequibilidad[salario_hora_2026]), REMOVEFILTERS(asequibilidad), asequibilidad[salario_corto] = "Piso legal")
		formatString: \$#,0.00
		lineageTag: 916679a1-799f-538e-ba0f-41069b043c6e

