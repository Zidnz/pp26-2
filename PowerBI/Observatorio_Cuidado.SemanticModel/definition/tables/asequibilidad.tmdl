	partition asequibilidad = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "asequibilidad.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"fuente_ingreso", type text}, {"fuente_orden", Int64.Type}, {"salario", type text}, {"salario_corto", type text}, {"salario_hora_2026", type number}, {"paquete", type text}, {"paquete_corto", type text}, {"horas", Int64.Type}, {"costo_mensual_2026", Int64.Type}, {"pct_ingreso_mediano", type number}, {"umbral", type text}, {"umbral_orden", Int64.Type}, {"pct_hogares", type number}, {"li90", type number}, {"ls90", type number}, {"precision", type text}, {"n", Int64.Type}, {"fuente", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

