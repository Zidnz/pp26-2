	partition modelo_decision = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "modelo_decision.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"orden", Int64.Type}, {"criterio", type text}, {"tipo", type text}, {"algun_dano", type text}, {"salud_fisica", type text}, {"favorece", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

