	column pct_60
		dataType: double
		formatString: 0.00
		lineageTag: 5f8a86d3-64f8-5ee4-af1e-408c68364159
		summarizeBy: none
		sourceColumn: pct_60

		annotation SummarizationSetBy = User

	column pct_disc
		dataType: double
		formatString: 0.00
		lineageTag: 193045b8-5d3c-507f-8b29-0944c82885f3
		summarizeBy: none
		sourceColumn: pct_disc

		annotation SummarizationSetBy = User

	column pct_sinder
		dataType: double
		formatString: 0.00
		lineageTag: 76cdfdb6-4c1e-5c5d-9f12-3531dc83037c
		summarizeBy: none
		sourceColumn: pct_sinder

		annotation SummarizationSetBy = User

	column graproes
		dataType: double
		formatString: 0.00
		lineageTag: 6edcaa4e-090d-5432-9ef8-b10ed1d1e5f2
		summarizeBy: none
		sourceColumn: graproes

		annotation SummarizationSetBy = User

	column pct_sin_int
		dataType: double
		formatString: 0.00
		lineageTag: 1f081927-f740-5bbf-9347-73b6ff93ac1f
		summarizeBy: none
		sourceColumn: pct_sin_int

		annotation SummarizationSetBy = User

	column dist_oferta_km
