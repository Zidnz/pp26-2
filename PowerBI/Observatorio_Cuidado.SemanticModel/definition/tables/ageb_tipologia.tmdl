table ageb_tipologia
	lineageTag: e0a07ed3-c69e-501e-acfa-326e42f2972b

	measure AGEB = COUNTROWS(ageb_tipologia)
		formatString: #,0
		lineageTag: 26773a62-7c65-5495-b6c8-058dd0b035ad

	measure '% 60+' = AVERAGE(ageb_tipologia[pct_60])
		formatString: 0.0
		lineageTag: e5b909f8-e579-5501-9ee9-e606a7737261

	measure '% viviendas sin internet' = AVERAGE(ageb_tipologia[pct_sin_int])
		formatString: 0.0
		lineageTag: 7e9832f5-0c27-5d99-bcf8-b8ff91dc3d05

	column cvegeo
		dataType: string
		lineageTag: 3a9eabc0-d659-5eb9-8570-896f79db016e
		summarizeBy: none
		sourceColumn: cvegeo

		annotation SummarizationSetBy = User

	column alcaldia
		dataType: string
		lineageTag: ae8545ce-dc93-5caa-917f-0300babf641f
		summarizeBy: none
		sourceColumn: alcaldia

		annotation SummarizationSetBy = User

	column tipo
