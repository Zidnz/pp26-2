		summarizeBy: none
		sourceColumn: tipo_txt

		annotation SummarizationSetBy = User

	partition ageb_tipologia = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "ageb_tipologia.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"cvegeo", type text}, {"alcaldia", type text}, {"tipo", Int64.Type}, {"poblacion", Int64.Type}, {"n_60", Int64.Type}, {"pct_60", type number}, {"pct_disc", type number}, {"pct_sinder", type number}, {"graproes", type number}, {"pct_sin_int", type number}, {"dist_oferta_km", type number}, {"brecha", type text}, {"frontera", type text}, {"tipo_txt", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

