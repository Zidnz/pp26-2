table razones
	lineageTag: b66b379e-7edc-5c20-92ec-cd55dc0cc4c9

	measure 'Porcentaje razón' = AVERAGE(razones[pct])
		formatString: 0.0\%
		lineageTag: c332097f-2e8a-5a28-987a-db23da57573f

	measure 'IC90 inf razón' = AVERAGE(razones[li90])
		formatString: 0.0
		lineageTag: 5ff3c4fc-4971-5fb6-bc81-9a94f89a3a0b

	measure 'IC90 sup razón' = AVERAGE(razones[ls90])
		formatString: 0.0
		lineageTag: 7402e592-ca3d-5bb7-929d-4398b1d16670

	measure 'n razón' = MAX(razones[n])
		formatString: #,0
		lineageTag: 756e3ba8-51d7-5de0-b119-6481d6a9c7fc

	measure 'Precisión razón' = MAX(razones[precision])
		lineageTag: dfb60d00-ac54-5b4f-ab36-c6eb5e345195

	measure 'Color razón' = SWITCH(MAX(razones[precision]), "baja", "#D9D4E6", "moderada", "#A99FC9", "sin varianza", "#9A93AD", "#77689D")
		lineageTag: 0b9d3eba-50db-5195-a1ae-1208eaac0905

	column universo
		dataType: string
		lineageTag: d88f20ce-a794-54b3-8b28-2a0826813c22
