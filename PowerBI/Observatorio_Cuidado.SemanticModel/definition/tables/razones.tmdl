		annotation SummarizationSetBy = User

	column li90
		dataType: double
		formatString: 0.00
		lineageTag: 122c485e-865f-5397-9055-0d5f941a3e6d
		summarizeBy: none
		sourceColumn: li90

		annotation SummarizationSetBy = User

	column ls90
		dataType: double
		formatString: 0.00
		lineageTag: f52bb0df-a326-5bb5-a02d-fed6bbb35b48
