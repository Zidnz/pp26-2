	partition seg_indicadores = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "seg_indicadores.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"seg_id", type text}, {"dimension", type text}, {"segmento", type text}, {"clave", type text}, {"indicador", type text}, {"ind_corto", type text}, {"comparar_en", type text}, {"grupo", type text}, {"ind_orden", Int64.Type}, {"pct", type number}, {"cv", type number}, {"li90", type number}, {"ls90", type number}, {"n", Int64.Type}, {"precision", type text}, {"dif_pp", type number}, {"dif_li90", type number}, {"dif_ls90", type number}, {"dif_significativa", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

