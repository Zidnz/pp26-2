table seg_indicadores
	lineageTag: 71732dce-75a7-5542-aad0-17e8a215a877

	measure 'Porcentaje seg' = AVERAGE(seg_indicadores[pct])
		formatString: 0.0\%
		lineageTag: 70dd7b78-5184-5dcb-a89c-97a95d57b064

	measure 'Dif vs resto pp' = AVERAGE(seg_indicadores[dif_pp])
		formatString: +0.0;-0.0;0.0
		lineageTag: 1dba4e0d-d5dd-594f-a62b-19156a0005e9

	measure 'IC90 inf seg' = AVERAGE(seg_indicadores[li90])
		formatString: 0.0
		lineageTag: 80bb2e59-8963-537d-a665-fa3479f44c17

	measure 'IC90 sup seg' = AVERAGE(seg_indicadores[ls90])
		formatString: 0.0
		lineageTag: 30029c39-298a-5d82-98fa-e0ff03542749

	measure 'n seg' = MAX(seg_indicadores[n])
		formatString: #,0
		lineageTag: e6608fe8-525d-5c5b-92c4-998e2bc9fa95

	measure 'Precisión seg' = MAX(seg_indicadores[precision])
		lineageTag: 35996b6e-8651-521b-a49c-8a918159ce47

	measure 'Orden indicador' = MIN(seg_indicadores[ind_orden])
		formatString: 0
		lineageTag: e88b770c-e52a-5a0b-bfe4-ee05870546f6

	measure 'Color celda' = VAR p = AVERAGE(seg_indicadores[pct]) VAR pr = MAX(seg_indicadores[precision]) RETURN IF(pr = "baja", "#ECEAF1", IF(p >= 70, "#8A76B8", IF(p >= 50, "#B09FD3", IF(p >= 30, "#D3C8E8", "#EFEAF7"))))
		lineageTag: 223c54d9-3541-5c07-96ea-487542a8a090

	measure 'Precio (son caros)' = CALCULATE(AVERAGE(seg_indicadores[pct]), seg_indicadores[clave] = "raz_caros")
		formatString: 0.0\%
		lineageTag: 1bbddd51-3031-5014-944a-f38a7b568788

	measure 'Norma familiar' = CALCULATE(AVERAGE(seg_indicadores[pct]), seg_indicadores[clave] = "norma_familia")
		formatString: 0.0\%
		lineageTag: 00038f76-24e8-5cdc-b0d0-b1d506dbf8a8

