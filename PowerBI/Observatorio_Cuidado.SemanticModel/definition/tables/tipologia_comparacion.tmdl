	partition tipologia_comparacion = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "tipologia_comparacion.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"particion", type text}, {"grupos", Int64.Type}, {"r2_9_variables", type number}, {"ari_promedio", type number}, {"ari_min", type number}, {"cramer_v_rezago_coneval", type number}, {"eta2_pct_limitacion", type number}, {"eta2_log_distancia_oferta", type number}, {"vecinos_mismo_grupo", type number}}, "en-US")
				in
