	partition modelo_alternativas = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "modelo_alternativas.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"objetivo", type text}, {"puntaje", type text}, {"tipo", type text}, {"auc_ponderado", type number}, {"brier_ponderado", type number}, {"brier_referencia", type number}, {"precision", type number}, {"cobertura", type number}, {"cob_li90", type number}, {"cob_ls90", type number}, {"dif_cobertura_vs_regla", type number}, {"dif_li90", type number}, {"dif_ls90", type number}, {"admite_pesos", type text}, {"interpretable", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

