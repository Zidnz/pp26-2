table modelo_alternativas
	lineageTag: 690caca9-8478-5c4d-a6d8-fcbc98e795fc

	measure 'Dif cobertura vs regla' = AVERAGE(modelo_alternativas[dif_cobertura_vs_regla])
		formatString: +0.0;-0.0;0.0
		lineageTag: 652c0d3c-a9e6-593c-ab93-1255abc9a7d8

	measure 'IC90 inf alt' = AVERAGE(modelo_alternativas[dif_li90])
