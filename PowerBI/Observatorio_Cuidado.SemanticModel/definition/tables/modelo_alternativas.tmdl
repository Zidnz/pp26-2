	measure 'Cobertura alt' = AVERAGE(modelo_alternativas[cobertura])
		formatString: 0.0\%
		lineageTag: 99140beb-d0cf-50be-9901-b72c912a5165

	measure 'Color alternativa' = SWITCH(MAX(modelo_alternativas[tipo]), "Elegido", "#A9711A", "Horas como puntaje", "#77689D", "#9A93AD")
		lineageTag: a16033b9-626f-5d62-bdb4-357c751e3d79

