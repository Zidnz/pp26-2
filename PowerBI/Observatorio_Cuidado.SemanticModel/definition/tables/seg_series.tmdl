	partition seg_series = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "seg_series.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"seg_id", type text}, {"dimension", type text}, {"segmento", type text}, {"serie", type text}, {"serie_txt", type text}, {"categoria", type text}, {"etiqueta", type text}, {"cat_orden", Int64.Type}, {"pct", type number}, {"cv", type number}, {"li90", type number}, {"ls90", type number}, {"n", Int64.Type}, {"total_expandido", type number}, {"precision", type text}, {"dif_significativa", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

