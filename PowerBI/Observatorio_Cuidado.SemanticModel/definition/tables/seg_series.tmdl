table seg_series
	lineageTag: 4518ba8c-6f65-5baf-817d-7981f75a9a90

	measure Porcentaje = AVERAGE(seg_series[pct])
		formatString: 0.0\%
		lineageTag: 18729950-27d6-528c-9715-9d03c5d4d912

	measure 'Diferencia pp' = AVERAGE(seg_series[pct])
		formatString: +0.0;-0.0;0.0
		lineageTag: dee2be11-276e-58cc-9bbe-e09959896516

	measure 'IC90 inferior' = AVERAGE(seg_series[li90])
		formatString: 0.0
		lineageTag: f54d426b-ecbd-57c4-bece-e1d5e7e3f19a

	measure 'IC90 superior' = AVERAGE(seg_series[ls90])
		formatString: 0.0
		lineageTag: 0dc4942c-0bb9-51ca-b313-282adfd521f6

	measure 'n muestra' = MAX(seg_series[n])
		formatString: #,0
		lineageTag: 34eac345-7e38-5e09-a424-d4a2143b4664

	measure Precisión = MAX(seg_series[precision])
		lineageTag: 5d4a30be-a63c-51e6-a3d2-d32a962e26d6

	measure 'Orden categoría' = MIN(seg_series[cat_orden])
		formatString: 0
		lineageTag: b15065f3-fed8-595c-802e-97454cebc728

	measure 'Color precisión' = SWITCH(MAX(seg_series[precision]), "baja", "#D9D4E6", "moderada", "#A99FC9", "sin varianza", "#9A93AD", "#77689D")
		lineageTag: 89e83c12-e81b-5f1a-b66f-6f92464c121e

	measure 'Color diferencia' = IF(MAX(seg_series[dif_significativa]) = "Sí", "#C0435A", "#B8B3C9")
		lineageTag: 151760ca-59d5-5065-9939-34afcc229936

	measure 'KPI personas' = CALCULATE(AVERAGE(seg_series[total_expandido]), seg_series[serie] = "kpi", seg_series[categoria] = "personas")
		formatString: #,0
		lineageTag: 00b13b66-d22c-5439-992b-d18a3d9ede9f

	measure 'KPI grupo del problema' = CALCULATE(AVERAGE(seg_series[pct]), seg_series[serie] = "kpi", seg_series[categoria] = "grupo")
		formatString: 0.0\%
		lineageTag: 2fbd6992-ec34-503a-ab7f-a25f8f07e00c

	measure 'KPI grupo personas' = CALCULATE(AVERAGE(seg_series[total_expandido]), seg_series[serie] = "kpi", seg_series[categoria] = "grupo")
		formatString: #,0
		lineageTag: 8944712a-3b50-5e34-886e-ad25295ea3f7

	measure 'KPI horas a la semana' = CALCULATE(AVERAGE(seg_series[pct]), seg_series[serie] = "kpi", seg_series[categoria] = "horas_total")
		formatString: #,0
		lineageTag: ff8aedc3-bb63-58cd-a23c-53883e96307e

	measure 'KPI horas promedio' = CALCULATE(AVERAGE(seg_series[pct]), seg_series[serie] = "kpi", seg_series[categoria] = "horas_media")
		formatString: 0.0
		lineageTag: 53b258c7-caff-584a-8e5f-80529ba3f68e

	measure 'Mediana de horas' = CALCULATE(AVERAGE(seg_series[pct]), seg_series[serie] = "horas", seg_series[categoria] = "mediana")
		formatString: 0
		lineageTag: 30b61d63-a2b8-552a-924d-4dd06297f083

	measure 'Tratan mal (P7.11)' = CALCULATE(AVERAGE(seg_series[pct]), seg_series[serie] = "p711", seg_series[categoria] = "Tratan mal a las personas")
		formatString: 0.0\%
		lineageTag: 233fde38-dc5a-56c7-9ae9-f7e5eba22a85

