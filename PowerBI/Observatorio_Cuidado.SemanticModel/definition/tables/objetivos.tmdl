table objetivos
	lineageTag: 330031bc-da3e-5bea-8c9f-02f231eff638

	column objetivo
		dataType: string
		lineageTag: 8d99e6f8-9198-5007-bf0a-9ba0aa446e21
		summarizeBy: none
		sourceColumn: objetivo

		annotation SummarizationSetBy = User

	column objetivo_txt
		dataType: string
		lineageTag: 978cdfaa-a30b-5df5-b3ed-6e813b8ec93f
		summarizeBy: none
		sourceColumn: objetivo_txt
		sortByColumn: orden

		annotation SummarizationSetBy = User

	column orden
		dataType: int64
		formatString: 0
		lineageTag: 1131edbf-a638-5c3e-9bea-d6097b910901
		summarizeBy: none
		sourceColumn: orden

		annotation SummarizationSetBy = User

	partition objetivos = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "objetivos.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"objetivo", type text}, {"objetivo_txt", type text}, {"orden", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

