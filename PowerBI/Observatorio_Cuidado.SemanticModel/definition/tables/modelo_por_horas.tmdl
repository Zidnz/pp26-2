table modelo_por_horas
	lineageTag: 88f2d920-2695-5678-a0b9-fcc14f70ec1a

	measure 'Prevalencia (%)' = AVERAGE(modelo_por_horas[prevalencia])
		formatString: 0.0\%
		lineageTag: 6fe2f2ed-2783-57b2-92c5-12eb0febaff9

	measure 'Orden horas' = MIN(modelo_por_horas[orden])
		formatString: 0
		lineageTag: 352c04f0-d76a-5561-9b70-a08b7ac17947

