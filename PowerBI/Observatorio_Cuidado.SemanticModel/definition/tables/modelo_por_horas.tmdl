	partition modelo_por_horas = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "modelo_por_horas.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"objetivo", type text}, {"objetivo_txt", type text}, {"horas", type text}, {"orden", Int64.Type}, {"prevalencia", type number}, {"li90", type number}, {"ls90", type number}, {"n", Int64.Type}, {"n_con_dano", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

