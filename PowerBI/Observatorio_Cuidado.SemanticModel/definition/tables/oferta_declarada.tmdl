	partition oferta_declarada = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "oferta_declarada.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"clave", type text}, {"grupo", type text}, {"pct", type number}, {"cv", type number}, {"li90", type number}, {"ls90", type number}, {"total_expandido", type number}, {"precision", type text}, {"n", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

