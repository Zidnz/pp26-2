table embudo
	lineageTag: 28a99a16-d980-5d02-a0cf-f1c2a1e42463

	measure Personas = SUM(embudo[total])
		formatString: #,0
		lineageTag: 1363bde9-9f7a-5060-8175-9bed258706a8

	column orden
		dataType: int64
		formatString: 0
		lineageTag: 5ec8b6af-200a-5e54-9f8f-3119399357d0
		summarizeBy: none
		sourceColumn: orden

		annotation SummarizationSetBy = User

	column etapa
		dataType: string
		lineageTag: c34945af-3075-509f-bb37-3c41b5918f59
		summarizeBy: none
		sourceColumn: etapa
		sortByColumn: orden

		annotation SummarizationSetBy = User

	column total
		dataType: double
		formatString: 0.00
		lineageTag: a38deb29-a287-5b66-ad65-6f38ff121207
		summarizeBy: none
		sourceColumn: total

		annotation SummarizationSetBy = User

	column fuente
		dataType: string
		lineageTag: 87bc5e25-55d7-5934-ba13-90c4e70827e0
		summarizeBy: none
		sourceColumn: fuente

		annotation SummarizationSetBy = User

	partition embudo = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "embudo.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"orden", Int64.Type}, {"etapa", type text}, {"total", type number}, {"fuente", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

