	partition modelo_global = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "modelo_global.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"objetivo", type text}, {"puntaje", type text}, {"auc_ponderado", type number}, {"tasa_seleccion", type number}, {"precision", type number}, {"cobertura", type number}, {"cobertura_li90", type number}, {"cobertura_ls90", type number}, {"dif_cobertura_vs_regla", type number}, {"dif_li90", type number}, {"dif_ls90", type number}, {"n_seleccionados_muestra", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

