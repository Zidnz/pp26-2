table modelo_global
	lineageTag: a16d8b3d-7b34-57cd-a8e6-43524fc714bd

	measure 'Cobertura regla' = CALCULATE(AVERAGE(modelo_global[cobertura]), modelo_global[objetivo] = "DANO_ALGUNO", modelo_global[puntaje] = "Regla >= 40 h")
		formatString: 0.0\%
		lineageTag: 378f67d5-64a6-5956-8bbb-fb0ac281d211

	measure 'Cobertura logística' = CALCULATE(AVERAGE(modelo_global[cobertura]), modelo_global[objetivo] = "DANO_ALGUNO", modelo_global[puntaje] = "Regresión logística")
		formatString: 0.0\%
		lineageTag: 411f9532-3067-5518-adb0-bee9dc6f5049

	measure 'Diferencia logística pp' = CALCULATE(AVERAGE(modelo_global[dif_cobertura_vs_regla]), modelo_global[objetivo] = "DANO_ALGUNO", modelo_global[puntaje] = "Regresión logística")
		formatString: +0.0;-0.0;0.0
		lineageTag: 81851ac5-0b10-5035-aa21-e4c51dc03b7c

	measure 'Diferencia salud física pp' = CALCULATE(AVERAGE(modelo_global[dif_cobertura_vs_regla]), modelo_global[objetivo] = "DANO_SALUD_FISICA", modelo_global[puntaje] = "Regresión logística")
