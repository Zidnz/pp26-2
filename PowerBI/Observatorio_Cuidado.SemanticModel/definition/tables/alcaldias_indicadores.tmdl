	column fuente
		dataType: string
		lineageTag: 363d01d7-788b-582a-8e72-61a74309f870
		summarizeBy: none
		sourceColumn: fuente

		annotation SummarizationSetBy = User

	partition alcaldias_indicadores = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "alcaldias_indicadores.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"alcaldia", type text}, {"indicador_clave", type text}, {"indicador", type text}, {"indicador_orden", Int64.Type}, {"valor", type number}, {"conteo", Int64.Type}, {"pct_pob60", type number}, {"fuente", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

