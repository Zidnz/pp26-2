				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"objetivo", type text}, {"puntaje", type text}, {"variable", type text}, {"variable_txt", type text}, {"caida_auc", type number}, {"caida_auc_cent", type number}, {"de", type number}}, "en-US")
