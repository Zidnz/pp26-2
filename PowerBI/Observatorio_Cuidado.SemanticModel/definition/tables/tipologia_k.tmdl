				    Tipos = Table.TransformColumnTypes(Vacios, {{"k", Int64.Type}, {"inercia", type number}, {"silueta", type number}, {"silueta_nula_media", type number}, {"silueta_nula_p95", type number}, {"calinski_harabasz", type number}, {"davies_bouldin", type number}, {"ari_promedio", type number}, {"ari_min", type number}, {"tamano_menor", Int64.Type}, {"estable", type text}, {"supera_nula", type text}}, "en-US")
