table brecha_sexo
	lineageTag: 9c2fd705-ae73-50e8-92ab-2e6bacf9a1d2

	measure 'Horas semanales' = AVERAGE(brecha_sexo[horas])
		formatString: 0.0
		lineageTag: af13a1f6-23c7-5ebd-8c3c-a1270ab50400

	measure 'Orden edad' = MIN(brecha_sexo[orden])
		formatString: 0
		lineageTag: 876606f6-45be-5d07-a412-4df7c5a3dfbc

	column edad
		dataType: string
		lineageTag: b81959f8-91e1-5e24-9327-b463bfcecf3e
		summarizeBy: none
		sourceColumn: edad

		annotation SummarizationSetBy = User

	column orden
		dataType: int64
		formatString: 0
		lineageTag: 8934f988-e2aa-54d7-9b56-20cd6aec80f8
		summarizeBy: none
		sourceColumn: orden

		annotation SummarizationSetBy = User

	column sexo
		dataType: string
		lineageTag: f93a8698-03ce-5040-97b4-b7e5ddd8c44f
		summarizeBy: none
		sourceColumn: sexo

		annotation SummarizationSetBy = User

	column horas
		dataType: double
		formatString: 0.00
		lineageTag: 8fd5424b-6ee9-5b0e-b700-74959438963d
		summarizeBy: none
		sourceColumn: horas

		annotation SummarizationSetBy = User

	column razon_m_h
		dataType: double
		formatString: 0.00
		lineageTag: 78293d2a-31c2-5302-a603-e01e6be5937d
		summarizeBy: none
		sourceColumn: razon_m_h

		annotation SummarizationSetBy = User

	partition brecha_sexo = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "brecha_sexo.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"edad", type text}, {"orden", Int64.Type}, {"sexo", type text}, {"horas", type number}, {"razon_m_h", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

