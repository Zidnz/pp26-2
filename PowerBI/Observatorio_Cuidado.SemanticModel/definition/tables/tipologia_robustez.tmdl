table tipologia_robustez
	lineageTag: 20a69235-b9bb-5782-aeba-fc099f0ce80e

	measure 'Coincidencia ARI' = AVERAGE(tipologia_robustez[ari])
		formatString: 0.000
		lineageTag: 2c7c11cb-2c8a-5f43-969c-b0cb4ec5bfe4

	column orden
		dataType: int64
		formatString: 0
		lineageTag: ea06d8d1-9708-58e8-9c1a-507f56cae485
		summarizeBy: none
		sourceColumn: orden

		annotation SummarizationSetBy = User

	column variante
		dataType: string
		lineageTag: 6fea58eb-1bda-549c-8c37-b5000952e675
		summarizeBy: none
		sourceColumn: variante

		annotation SummarizationSetBy = User

	column ari
		dataType: double
		formatString: 0.00
		lineageTag: 358bcb79-6a63-5302-a2fa-e49174485a66
		summarizeBy: none
		sourceColumn: ari

		annotation SummarizationSetBy = User

	partition tipologia_robustez = m
		mode: import
		source =
				let
				    Origen = Csv.Document(File.Contents(RutaDatos & "tipologia_robustez.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Encabezados = Table.PromoteHeaders(Origen, [PromoteAllScalars = true]),
				    Vacios = Table.TransformColumns(Encabezados, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Vacios, {{"orden", Int64.Type}, {"variante", type text}, {"ari", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table

